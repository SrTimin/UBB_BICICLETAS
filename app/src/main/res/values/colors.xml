    <!-- Variante del color primario para contenedores -->
    <color name="primary_container">#d3e4ff</color>
    <color name="primary_container_dark">#001e3d</color>  <!-- Versión oscura para el modo nocturno -->
    <color name="on_primary_container">#001c38</color>
    
    <!-- Paleta secundaria - Tonos de azul complementarios para elementos interactivos -->
    <color name="secondary">#0d6efd</color>
