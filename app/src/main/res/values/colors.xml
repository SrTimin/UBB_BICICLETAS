<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colores originales (algunos mantenidos como referencia) -->
    <color name="prussian_blue">#002d54</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    
    <!-- Nueva paleta moderna centrada en azul prusiano -->
    <!-- Paleta primaria -->
    <color name="primary">#002d54</color> <!-- Azul Prusiano original -->
