<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base rediseñado para BikeUBB con azul prusiano como color predominante -->
    <style name="Theme.UBBBICICLETAS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Colores de acento -->
        <item name="colorAccent">@color/accent</item>

        <!-- Colores de superficie -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Colores para textos -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Colores de barra de estado -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Colores de barra de navegación -->
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Configuración de formas -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BikeUBB.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BikeUBB.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.BikeUBB.LargeComponent</item>

        <!-- Configuración global de tipografía -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- Estilo para campos de texto -->
    <style name="Widget.BikeUBB.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- Estilo para la barra de navegación inferior -->
    <style name="Widget.BikeUBB.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/ripple</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.BikeUBB.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.BikeUBB.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
        <item name="android:width">64dp</item>
        <item name="android:height">36dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
    </style>

</resources>
